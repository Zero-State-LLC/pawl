{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "python3 -m pawl hook protect --format cursor",
        "matcher": "Shell|Write|Delete",
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": "python3 -m pawl hook stop --format cursor --base origin/main",
        "loop_limit": 5
      }
    ]
  }
}
